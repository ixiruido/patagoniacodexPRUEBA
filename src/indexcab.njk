---
permalink: indexcab.html
indexcab: indexcab
---


<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="robots" content="{{ indexcab.meta.robots }}">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ indexcab.meta.titulo }}</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="{{ indexcab.meta.fondo }}">
    <link rel="stylesheet" href="estiloscab.css">
    <link rel="icon" href="{{ indexcab.meta.favicon }}" type="image/png">
</head>
<body>

    <header>
        <div class="logo">{{ indexcab.header.logo }}</div>
        <nav>
            {% for nav in indexcab.header.navegacion %}
            <a href="{{ nav.url }}">{{ nav.texto }}</a>
            {% endfor %}
        </nav>
    </header>

    {% for seccion in indexcab.secciones %}
    {% if seccion.type == "hero" %}
    <section class="hero" id="{{ seccion.id }}">
        <h1>{{ seccion.titulo }}</h1>
        <p>{{ seccion.subtitulo }}</p>
        <a href="{{ seccion.boton_url }}" class="btn-gold">{{ seccion.boton_texto }}</a>
    </section>
    {% endif %}

    {% if seccion.type == "about" %}
    <section class="about" id="{{ seccion.id }}">
        <div class="about-img">
            <img src="{{ seccion.imagen }}" alt="{{ seccion.imagen_alt }}">
        </div>
        <div class="about-content">
            <h2>{{ seccion.titulo }}</h2>
            {% for parrafo in seccion.texto %}
            <p>{{ parrafo }}</p>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "services" %}
    <section class="services" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <div class="services-grid">
            {% for tarjeta in seccion.tarjetas %}
            <div class="card reveal">
                <h3>{{ tarjeta.titulo }}</h3>
                <p>{{ tarjeta.descripcion }}</p>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "gallery" %}
    <section class="gallery" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <p class="gallery-subtitle">{{ seccion.subtitulo }}</p>
        <div class="gallery-grid reveal">
            {% for imagen in seccion.imagenes %}
            <div class="gallery-item">
                <img src="{{ imagen.src }}" alt="{{ imagen.alt }}">
                <div class="gallery-caption">{{ imagen.caption }}</div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "contact" %}
    <section class="contact" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <p class="contact-subtitle">{{ seccion.subtitulo }}</p>
        <div class="contact-grid reveal">
            {% for tarjeta in seccion.tarjetas %}
            <a href="{{ tarjeta.url }}" class="contact-card {{ tarjeta.tipo }}-card" target="_blank" rel="noopener noreferrer">
                <span class="contact-icon">
                    {% if tarjeta.tipo == "whatsapp" %}
                    <svg viewBox="0 0 32 32" width="42" height="42">
                        <path d="M16 2a13 13 0 0 0-11.3 19.4L3 29l7.8-2A13 13 0 1 0 16 2zm0 24a11 11 0 0 1-5.6-1.5l-.4-.2-4.6 1.2 1.2-4.5-.3-.4A11 11 0 1 1 16 26zm6-8.2c-.3-.2-1.9-1-2.2-1-.3-.2-.5-.2-.8.2s-1 1.2-1.2 1.5-.4.3-.8.1a10 10 0 0 1-3-1.8 11 11 0 0 1-2-2.6c-.3-.5 0-.8.2-1l.6-.7.3-.5c.2-.3.1-.6 0-.8s-.7-1.7-1-2.4c-.3-.7-.6-.6-.8-.6h-.7a1.4 1.4 0 0 0-1 1.1A5.3 5.3 0 0 0 9 14a11 11 0 0 0 4.6 6.1c.5.3 1 .6 1.7.8a6.4 6.4 0 0 0 2.6.2 4.3 4.3 0 0 0 2.9-2 3.5 3.5 0 0 0 .2-2.1c-.1-.3-.4-.5-.8-.7z"/>
                    </svg>
                    {% elif tarjeta.tipo == "instagram" %}
                    <svg viewBox="0 0 24 24" width="40" height="40">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                    </svg>
                    {% elif tarjeta.tipo == "email" %}
                    <svg viewBox="0 0 24 24" width="40" height="40">
                        <path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l10 8.104 10-8.104v11.817h-20z"/>
                    </svg>
                    {% endif %}
                </span>
                <h3>{{ tarjeta.titulo }}</h3>
                <p>{{ tarjeta.descripcion }}</p>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "location" %}
    <section class="location" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <p class="location-subtitle">{{ seccion.subtitulo }}</p>
        <div class="location-container reveal">
            <div class="location-info">
                <h3>{{ seccion.titulo_info }}</h3>
                <div class="info-item">
                    <span class="info-icon">📍</span>
                    <p>{{ seccion.direccion }}</p>
                </div>
                <div class="info-item">
                    <span class="info-icon">🕐</span>
                    <p>{{ seccion.horario }}</p>
                </div>
                <div class="info-item">
                    <span class="info-icon">📞</span>
                    <p>{{ seccion.telefono }}</p>
                </div>
            </div>
            <div class="map-container">
                <iframe 
                    src="{{ seccion.mapa_url }}"
                    width="100%" 
                    height="100%" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade"
                    title="{{ seccion.mapa_titulo }}">
                </iframe>
            </div>
        </div>
    </section>
    {% endif %}
    {% endfor %}

    <footer>
        <div class="footer-grid">
            <div class="footer-col">
                <h4>{{ indexcab.footer.columna1_titulo }}</h4>
                <p>{{ indexcab.footer.columna1_texto }}</p>
            </div>
            <div class="footer-col">
                <h4>{{ indexcab.footer.columna2_titulo }}</h4>
                <ul>
                    {% for nav in indexcab.footer.navegacion %}
                    <li><a href="{{ nav.url }}">{{ nav.texto }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div class="footer-col">
                <h4>{{ indexcab.footer.columna3_titulo }}</h4>
                <ul><li><a href="{{ indexcab.footer.email_url }}">{{ indexcab.footer.email }}</a></ul></li>
                <p>{{ indexcab.footer.direccion }}</p>
                <ul><li><a href="{{ indexcab.footer.whatsapp_url }}"><br>{{ indexcab.footer.whatsapp_texto }}</a></ul></li>
            </div>
            <div class="footer-col">
                <h4>{{ indexcab.footer.columna4_titulo }}</h4>
                <p>
                    <img src="{{ indexcab.footer.qr_imagen }}" alt="{{ indexcab.footer.qr_alt }}" style="max-width: 100px; width: 100%; height: auto;"><br>
                    {{ indexcab.footer.qr_texto }}
                </p>
            </div>
        </div>

        <div class="footer-bottom">
            <p>{{ indexcab.footer.copyright }}</p>
            <a href="{{ indexcab.footer.patagonia_link }}" style="font-size: 0.6rem; text-decoration: none; color: rgb(107, 99, 99);">PATAGONIA CODEX</a>
        </div>
    </footer>

    <a href="{{ indexcab.footer.whatsapp_float_url }}" class="whatsapp-float" target="_blank" rel="noopener noreferrer" title="Contactar por WhatsApp">
        <svg viewBox="0 0 32 32">
            <path d="M16 2a13 13 0 0 0-11.3 19.4L3 29l7.8-2A13 13 0 1 0 16 2zm0 24a11 11 0 0 1-5.6-1.5l-.4-.2-4.6 1.2 1.2-4.5-.3-.4A11 11 0 1 1 16 26zm6-8.2c-.3-.2-1.9-1-2.2-1-.3-.2-.5-.2-.8.2s-1 1.2-1.2 1.5-.4.3-.8.1a10 10 0 0 1-3-1.8 11 11 0 0 1-2-2.6c-.3-.5 0-.8.2-1l.6-.7.3-.5c.2-.3.1-.6 0-.8s-.7-1.7-1-2.4c-.3-.7-.6-.6-.8-.6h-.7a1.4 1.4 0 0 0-1 1.1A5.3 5.3 0 0 0 9 14a11 11 0 0 0 4.6 6.1c.5.3 1 .6 1.7.8a6.4 6.4 0 0 0 2.6.2 4.3 4.3 0 0 0 2.9-2 3.5 3.5 0 0 0 .2-2.1c-.1-.3-.4-.5-.8-.7z"/>
        </svg>
    </a>

    <script src="scriptcab.js"></script>
</body>
</html>