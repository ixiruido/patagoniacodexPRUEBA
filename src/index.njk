---
permalink: index.html
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ meta.titulo }}</title>
    <link rel="preconnect" href="https://googleapis.com">
    <meta name="description" content="{{ meta.descripcion }}">
    <link rel="canonical" href="{{ meta.canonical }}">
    <meta name="robots" content="{{ meta.robots }}">
    <link rel="apple-touch-icon" href="{{ meta.favicon }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ meta.og_title }}">
    <meta property="og:description" content="{{ meta.og_description }}">
    <meta property="og:image" content="{{ meta.og_image }}">
    <meta property="og:url" content="{{ meta.og_url }}">
    <meta property="og:locale" content="{{ meta.og_locale }}">
    <meta name="theme-color" content="{{ meta.theme_color }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ meta.twitter_title }}">
    <meta name="twitter:description" content="{{ meta.twitter_description }}">
    <meta name="twitter:image" content="{{ meta.twitter_image }}">

    <script type="application/ld+json">
    {
      "@context":"https://schema.org",
      "@type":"ProfessionalService",
      "name":"Patagonia Codex",
      "url":"https://patagoniacodex.com.ar",
      "logo":"https://patagoniacodex.com.ar/favicon.png",
      "image":"https://patagoniacodex.com.ar/foto.jpg",
      "description":"Diseño de páginas web profesionales para empresas, comercios y emprendedores.",
      "telephone":"+5492996100676",
      "email":"ixi@patagoniacodex.com",
      "address":{
          "@type":"PostalAddress",
          "addressCountry":"AR"
      },
      "sameAs":[
          "https://www.instagram.com/ixi.real/"
      ]
    }
    </script>

    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="{{ secciones[0].fondo }}">
    <link rel="stylesheet" href="estilos.css">
    <link rel="icon" href="{{ meta.favicon }}" type="image/png">
</head>
<body>

    <header>
        <a href="{{ header.logo_url }}" style="color: inherit; text-decoration: none;">
            <div class="logo" style="letter-spacing: 6px;">{{ header.logo_texto }}
                <br><pre style="font-size: 14px; margin-top: -10px; text-align: center;">{{ header.logo_subtexto }}</pre>
            </div>
        </a>
        <nav>
            {% for nav in header.navegacion %}
            <a href="{{ nav.url }}">{{ nav.texto }}</a>
            {% endfor %}
        </nav>
    </header>

    {% for seccion in secciones %}
    {% if seccion.type == "hero" %}
    <section class="hero" id="{{ seccion.id }}">
        <h1>{{ seccion.titulo }}</h1>
        <p>{{ seccion.subtitulo }}</p>
        <a href="{{ seccion.boton_url }}" class="btn-gold">{{ seccion.boton_texto }}</a>
    </section>
    {% endif %}

    {% if seccion.type == "about" %}
    <section class="about" id="{{ seccion.id }}">
        <div class="about-img">
            <img src="{{ seccion.imagen }}" alt="{{ seccion.imagen_alt }}">
        </div>
        <div class="about-content">
            <h2>{{ seccion.titulo }}</h2>
            <p><br>{{ seccion.texto | safe }}</p>
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "services" %}
    <section class="services" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <div class="services-grid">
            {% for tarjeta in seccion.tarjetas %}
            <div class="card reveal">
                <h3>{{ tarjeta.titulo }}</h3>
                <p>{{ tarjeta.descripcion }}</p>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "contact" %}
    <section class="contact" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <p class="contact-subtitle">{{ seccion.subtitulo }}</p>
        <div class="contact-grid reveal">
            {% for tarjeta in seccion.tarjetas %}
            <a href="{{ tarjeta.url }}" class="contact-card {{ tarjeta.tipo }}-card" target="_blank" rel="noopener noreferrer">
                <span class="contact-icon">
                    {% if tarjeta.tipo == "whatsapp" %}
                    <svg viewBox="0 0 32 32" width="42" height="42">
                        <path d="M16 2a13 13 0 0 0-11.3 19.4L3 29l7.8-2A13 13 0 1 0 16 2zm0 24a11 11 0 0 1-5.6-1.5l-.4-.2-4.6 1.2 1.2-4.5-.3-.4A11 11 0 1 1 16 26zm6-8.2c-.3-.2-1.9-1-2.2-1-.3-.2-.5-.2-.8.2s-1 1.2-1.2 1.5-.4.3-.8.1a10 10 0 0 1-3-1.8 11 11 0 0 1-2-2.6c-.3-.5 0-.8.2-1l.6-.7.3-.5c.2-.3.1-.6 0-.8s-.7-1.7-1-2.4c-.3-.7-.6-.6-.8-.6h-.7a1.4 1.4 0 0 0-1 1.1A5.3 5.3 0 0 0 9 14a11 11 0 0 0 4.6 6.1c.5.3 1 .6 1.7.8a6.4 6.4 0 0 0 2.6.2 4.3 4.3 0 0 0 2.9-2 3.5 3.5 0 0 0 .2-2.1c-.1-.3-.4-.5-.8-.7z"/>
                    </svg>
                    {% elif tarjeta.tipo == "instagram" %}
                    <svg viewBox="0 0 24 24" width="40" height="40">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                    </svg>
                    {% elif tarjeta.tipo == "email" %}
                    <svg viewBox="0 0 24 24" width="40" height="40">
                        <path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l10 8.104 10-8.104v11.817h-20z"/>
                    </svg>
                    {% endif %}
                </span>
                <h3>{{ tarjeta.titulo }}</h3>
                <p>{{ tarjeta.descripcion }}</p>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "pricing" %}
    <section class="pricing" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <p class="contact-subtitle">{{ seccion.subtitulo }}</p>

        <div class="pricing-container">
            {% for tarjeta in seccion.tarjetas %}
            <div class="pricing-card">
                <div class="pricing-image">
                    <img src="{{ tarjeta.imagen }}" alt="{{ tarjeta.imagen_alt }}">
                </div>
                <div class="pricing-content">
                    <div class="pricing-header">
                        <div class="pricing-info">
                            <h3>{{ tarjeta.titulo }}</h3>
                            <div class="pricing-price">
                                <span class="price-amount">{{ tarjeta.precio }}</span>
                                <span class="pricing-currency">{{ tarjeta.moneda }}</span>
                            </div>
                            <p class="price-period" style="font-size: 13px;">{{ tarjeta.periodo }}</p>
                            <p style="font-size: 14px;">{{ tarjeta.metodo_pago }}</p>
                        </div>
                        <div class="pricing-action">
                            <p class="payment-method">{{ tarjeta.incluye }}</p>
                        </div>
                    </div>

                    <button class="btn-buy" onclick="window.open('{{ tarjeta.boton_url }}', '_blank')">
                        Comprar
                    </button>

                    <button class="btn-terms" onclick="toggleTerms()">
                        <span class="btn-text">Qué Incluye</span>
                        <span class="btn-arrow">▼</span>
                    </button>

                    <div class="terms-content" id="termsContent">
                        <div class="terms-columns">
                            <ul class="terms-list">
                                {% for termino in tarjeta.terminos %}
                                <li>{{ termino }}</li>
                                {% endfor %}

                                <button class="btn-buy" style="margin-top: 15px;" onclick="window.open('{{ tarjeta.boton_url }}', '_blank')">
                                    Comprar
                                </button>
                                <button class="btn-terms" onclick="toggleTerms()">
                                    <span class="btn-arrow">▲</span>
                                </button>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if seccion.type == "demos" %}
    <section class="demos" id="{{ seccion.id }}">
        <h2>{{ seccion.titulo }}</h2>
        <p class="contact-subtitle">{{ seccion.subtitulo }}</p>
        <div class="demo-grid">
            {% for tarjeta in seccion.tarjetas %}
            <div class="demo-card">
                <img src="{{ tarjeta.imagen }}" alt="{{ tarjeta.imagen_alt }}" loading="lazy">
                <div>
                    <h3>{{ tarjeta.titulo }}</h3>
                    <p>{{ tarjeta.descripcion }}</p>
                    <a href="{{ tarjeta.url }}" target="_blank">Ver demo</a>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}
    {% endfor %}

    <footer>
        <div class="footer-grid">
            <div class="footer-col">
                <a href="{{ footer.logo_url }}" style="color: inherit; text-decoration: none;">
                    <h4 style="letter-spacing: 6px;">{{ footer.logo_texto }}
                        <br><pre style="font-size: 10px; margin-top: -5px;">{{ footer.logo_subtexto }}</pre>
                    </h4>
                </a>
                <p>{{ footer.descripcion }}</p>
            </div>
            <div class="footer-col">
                <h4>Navegación</h4>
                <ul>
                    {% for nav in footer.navegacion %}
                    <li><a href="{{ nav.url }}">{{ nav.texto }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div class="footer-col">
                <h4>Contacto</h4>
                <ul><li><a href="{{ footer.contacto.email_url }}">{{ footer.contacto.email }}</a></ul></li>
                <ul><li>{{ footer.contacto.atencion }}</ul></li>
                <ul><li><a href="{{ footer.contacto.whatsapp_url }}">{{ footer.contacto.whatsapp_texto }}</a></ul></li>
                <ul><li><a href="{{ footer.contacto.telefono_url }}">{{ footer.contacto.telefono }}</a></ul></li>
            </div>

            <div class="footer-col">
                <h4>QR</h4>
                <p>
                    <a href="{{ footer.logo_url }}" style="color: inherit; text-decoration: none;">
                        <img src="{{ footer.qr_imagen }}" alt="{{ footer.qr_alt }}" style="max-width: 110px; width: 100%; height: auto;">
                    </a>
                </p>
                <p style="font-size: 12px;">{{ footer.qr_texto }}</p>
            </div>
        </div>

        <div class="footer-bottom">
            <p>{{ footer.copyright }}</p>
            <a href="./index.html" style="font-size: 0.6rem; text-decoration: none; color: rgb(97, 88, 88); letter-spacing: 6px;">{{ footer.logo_texto }}
                <br><pre style="font-size: 10px; margin-top: -5px; text-align: center;">{{ footer.logo_subtexto }}</pre>
            </a>
        </div>
    </footer>

    <a href="{{ footer.whatsapp_float_url }}" class="whatsapp-float" target="_blank" rel="noopener noreferrer" title="Contactar por WhatsApp">
        <svg viewBox="0 0 32 32">
            <path d="M16 2a13 13 0 0 0-11.3 19.4L3 29l7.8-2A13 13 0 1 0 16 2zm0 24a11 11 0 0 1-5.6-1.5l-.4-.2-4.6 1.2 1.2-4.5-.3-.4A11 11 0 1 1 16 26zm6-8.2c-.3-.2-1.9-1-2.2-1-.3-.2-.5-.2-.8.2s-1 1.2-1.2 1.5-.4.3-.8.1a10 10 0 0 1-3-1.8 11 11 0 0 1-2-2.6c-.3-.5 0-.8.2-1l.6-.7.3-.5c.2-.3.1-.6 0-.8s-.7-1.7-1-2.4c-.3-.7-.6-.6-.8-.6h-.7a1.4 1.4 0 0 0-1 1.1A5.3 5.3 0 0 0 9 14a11 11 0 0 0 4.6 6.1c.5.3 1 .6 1.7.8a6.4 6.4 0 0 0 2.6.2 4.3 4.3 0 0 0 2.9-2 3.5 3.5 0 0 0 .2-2.1c-.1-.3-.4-.5-.8-.7z"/>
        </svg>
    </a>

    <script src="script.js"></script>
    <script>

    </script>
</body>
</html>